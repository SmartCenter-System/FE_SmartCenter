{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/api/$1"
    },
    {
      "source": "/Enrollment/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/Enrollment/$1"
    },
    {
      "source": "/Section/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/Section/$1"
    },
    {
      "source": "/ExamPaper/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/ExamPaper/$1"
    },
    {
      "source": "/GradeExam/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/GradeExam/$1"
    },
    {
      "source": "/User/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/User/$1"
    },
    {
      "source": "/WeatherForecast/(.*)",
      "destination": "https://smartcenter-deploy-latest.onrender.com/WeatherForecast/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
